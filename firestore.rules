rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Fields: uid, email, displayName, role, createdAt
    //
    // Collection: bookings
    // Fields: userId, serviceName, date, time, status, userName, userEmail, createdAt
    //
    // Collection: chats
    // Fields: userId, userName, lastMessage, lastTimestamp, unreadCount
    //
    // Collection: chats/{chatId}/messages
    // Fields: senderId, senderName, text, timestamp, chatId
    //
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         (request.auth.token.email == "tedcharleschinekezi@gmail.com" && request.auth.token.email_verified == true));
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role']) &&
             data.uid is string &&
             data.email is string &&
             data.role in ['admin', 'user'];
    }

    function isValidBooking(data) {
      return data.keys().hasAll(['serviceName', 'date', 'time', 'status', 'userName', 'userEmail']) &&
             data.serviceName is string && data.serviceName.size() < 100 &&
             data.date is string &&
             data.time is string &&
             data.status in ['pending', 'confirmed', 'cancelled'] &&
             data.userName is string && data.userName.size() < 100 &&
             data.userEmail is string;
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['senderId', 'text', 'timestamp', 'chatId']) &&
             data.senderId is string &&
             data.text is string && data.text.size() < 5000 &&
             data.chatId is string;
    }

    // Rules
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() && isValidUser(request.resource.data) && (isOwner(userId) || isAdmin());
      allow update: if isAuthenticated() && isValidUser(request.resource.data) && (isAdmin() || (isOwner(userId) && request.resource.data.role == resource.data.role));
    }

    match /bookings/{bookingId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && isValidBooking(request.resource.data);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /chats/{chatId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /chats/{chatId}/messages/{messageId} {
      allow read: if isAuthenticated() && (get(/databases/$(database)/documents/chats/$(chatId)).data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && isValidMessage(request.resource.data);
    }
  }
}
